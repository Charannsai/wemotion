{
  "name": "wemotion",
  "version": "1.0.0",
  "private": true,
  "description": "WeMotion — AI-native professional motion-design editor for SaaS product videos",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx scripts/seed.ts",
    "setup": "npm run db:generate && npm run db:push && npm run db:seed && npm run capture:install",
    "capture:install": "playwright install chromium",
    "worker": "tsx scripts/worker.ts",
    "test": "tsx --test src/**/*.test.ts",
    "remotion:studio": "remotion studio remotion/index.ts"
  },
  "prisma": {
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.32.1",
    "@prisma/client": "6.1.0",
    "@remotion/bundler": "^4.0.514",
    "@remotion/cli": "^4.0.514",
    "@remotion/player": "^4.0.514",
    "@remotion/renderer": "^4.0.514",
    "clsx": "2.1.1",
    "date-fns": "^4.4.0",
    "groq-sdk": "^1.5.0",
    "jose": "5.9.6",
    "lucide-react": "0.469.0",
    "mammoth": "^1.12.1",
    "next": "^15.5.23",
    "next-auth": "^4.24.15",
    "pdfjs-dist": "4.9.155",
    "playwright": "^1.62.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "^4.0.514",
    "sharp": "^0.35.3",
    "tailwind-merge": "2.6.0",
    "zod": "3.24.1",
    "zustand": "5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "22.10.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "prisma": "6.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "5.7.2"
  },
  "overrides": {
    "sharp": "^0.35.3"
  }
}
